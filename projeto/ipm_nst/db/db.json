  "indicators": [
    {
      "id": 1,
      "numero": "RRF-01",
      "titulo": "Capacidade de energias renováveis instalada",
      "descricao": "Capacidade adicional de produção de energia a partir de fontes renováveis (eólica, solar, hídrica) instalada no âmbito do PRR.",
      "infoDetalhada": "Medida em gigawatts (GW), este indicador acompanha o avanço das metas climáticas inscritas em cada plano nacional. Inclui instalações em terreno e offshore."
    },
    {
      "id": 2,
      "numero": "RRF-02",
      "titulo": "Edifícios com eficiência energética melhorada",
      "descricao": "Número de edifícios residenciais e públicos que sofreram obras de reabilitação energética cofinanciadas pelo PRR.",
      "infoDetalhada": "Inclui isolamentos, substituição de janelas, instalação de painéis solares e bombas de calor. Meta europeia: redução de 30% do consumo de energia primária nos edifícios renovados."
    },
    {
      "id": 3,
      "numero": "RRF-03",
      "titulo": "Empresas com acesso a banda larga de alta velocidade",
      "descricao": "Número de empresas que passaram a ter acesso a ligações de fibra ótica ou 5G financiadas no âmbito das componentes digitais dos PRR.",
      "infoDetalhada": "Foca-se em zonas rurais e regiões de baixa densidade. Objetivo: eliminar o fosso digital entre zonas urbanas e rurais até 2026."
    },
    {
      "id": 4,
      "numero": "RRF-04",
      "titulo": "Postos de trabalho criados ou mantidos",
      "descricao": "Estimativa do número de empregos diretamente gerados ou preservados pelas reformas e investimentos dos PRR nacionais.",
      "infoDetalhada": "Calculado com base em modelos econométricos validados pela Comissão Europeia. Inclui emprego direto, indireto e induzido."
    },
    {
      "id": 5,
      "numero": "RRF-05",
      "titulo": "Crianças em creches e pré-escolar apoiadas",
      "descricao": "Número de crianças beneficiadas por novas vagas em creches e jardins de infância financiados pelo PRR.",
      "infoDetalhada": "Enquadrado na componente de inclusão social. Visa cumprir os objetivos do Pilar Europeu dos Direitos Sociais em cuidados à infância."
    },
    {
      "id": 6,
      "numero": "RRF-06",
      "titulo": "Utilizadores com acesso a serviços públicos digitais",
      "descricao": "Número de cidadãos que passaram a aceder a serviços da administração pública por via digital após modernização financiada pelo PRR.",
      "infoDetalhada": "Abrange portais de e-government, sistemas de saúde eletrónicos, certificados digitais e plataformas de benefícios sociais."
    },
    {
      "id": 7,
      "numero": "RRF-07",
      "titulo": "Quilómetros de ferrovia reabilitados ou construídos",
      "descricao": "Extensão total de linha ferroviária requalificada, eletrificada ou construída de raiz no âmbito das componentes de mobilidade sustentável.",
      "infoDetalhada": "Inclui alta velocidade, linhas suburbanas e redes de carga. Parte da estratégia de descarbonização do transporte terrestre."
    },
    {
      "id": 8,
      "numero": "RRF-08",
      "titulo": "Investigadores em projetos cofinanciados",
      "descricao": "Número de investigadores (equivalente a tempo inteiro) a trabalhar em projetos de I&D apoiados pelos planos de recuperação.",
      "infoDetalhada": "Inclui investigadores em universidades, laboratórios públicos e empresas privadas. Indicador central para medir o reforço do ecossistema de inovação."
    },
    {
      "id": 9,
      "numero": "RRF-09",
      "titulo": "PME com apoio a transformação digital",
      "descricao": "Número de pequenas e médias empresas que receberam apoio financeiro ou técnico para digitalizar processos internos e modelos de negócio.",
      "infoDetalhada": "Abrange software de gestão, plataformas de e-commerce, cibersegurança e formação digital para trabalhadores."
    },
    {
      "id": 10,
      "numero": "RRF-10",
      "titulo": "Capacidade instalada de armazenamento de energia",
      "descricao": "Capacidade adicional de baterias e outros sistemas de armazenamento energético instalados para suportar a integração de renováveis na rede.",
      "infoDetalhada": "Medido em MWh. Essencial para garantir a estabilidade da rede elétrica com elevada penetração de energias intermitentes."
    },
    {
      "id": 11,
      "numero": "RRF-11",
      "titulo": "Camas hospitalares renovadas ou criadas",
      "descricao": "Número de camas hospitalares em unidades de saúde reabilitadas, ampliadas ou construídas de raiz com fundos PRR.",
      "infoDetalhada": "Resposta à fragilidade revelada pelo COVID-19 nos sistemas de saúde europeus. Inclui UCI, enfermaria e cuidados continuados."
    },
    {
      "id": 12,
      "numero": "RRF-12",
      "titulo": "Hectares de floresta com gestão sustentável",
      "descricao": "Área florestal abrangida por planos de gestão sustentável, faixas de gestão de combustível e reflorestação com espécies autóctones.",
      "infoDetalhada": "Componente essencial das metas climáticas e de biodiversidade. Contribui para os objetivos da Estratégia de Biodiversidade 2030 da UE."
    },
    {
      "id": 13,
      "numero": "RRF-13",
      "titulo": "Adultos em formação e requalificação profissional",
      "descricao": "Número de adultos que participaram em programas de formação profissional, requalificação ou upskilling financiados pelo PRR.",
      "infoDetalhada": "Foco nas transições verde e digital. Inclui cursos técnicos, certificações digitais e programas para desempregados de longa duração."
    },
    {
      "id": 14,
      "numero": "RRF-14",
      "titulo": "Redução de emissões de CO₂ estimada",
      "descricao": "Estimativa da redução anual de emissões de gases com efeito de estufa resultante dos investimentos climáticos financiados pelo PRR.",
      "infoDetalhada": "Expresso em toneladas de CO₂ equivalente por ano. Calculado com base nas metodologias de marcadores climáticos da Comissão Europeia (Rio markers)."
    }
